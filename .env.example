# Telegram bot token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Telegram numeric user ID of the administrator
ADMIN_ID=YOUR_TELEGRAM_USER_ID
ADMIN_USERNAME=your_admin_username

# Payment details shown to users; AI recommendations require these too
CARD_NUMBER=YOUR_CARD_NUMBER
CARD_NAME=YOUR_CARDHOLDER_NAME

# OpenAI API key for paid AI movie recommendations
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Daily free movie views for non-Premium users
DAILY_FREE_LIMIT=3
